## a.— GREATEST AMONG THREE NUMBERS
#!/bin/bash
echo "ENTER THREE NUMBERS"
read a b c

if [ "$a" -gt "$b" ] && [ "$a" -gt "$c" ]; then
    echo "$a is greater"
elif [ "$b" -gt "$c" ]; then
    echo "$b is greater"
else
    echo "$c is greater"
fi
##Experiment 4(b): SHELL PROGRAM — FACTORIAL OF A GIVEN NUMBER
#!/bin/bash
echo "ENTER THE NUMBER:"
read n
fact=1

while [ "$n" -gt 1 ]; do
    fact=$((fact * n))
    n=$((n - 1))
done

echo "FACTORIAL OF THE GIVEN NUMBER IS $fact
##Experiment 4(c): SHELL PROGRAM — SUM OF ODD NUMBERS UPTO N
#!/bin/bash
echo "ENTER THE RANGE"
read n
x=1
sum=0

