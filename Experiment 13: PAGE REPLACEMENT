##Experiment 13(a): PAGE REPLACEMENT — FIFO
#include <stdio.h>

int main(void)
{
    int n, frames, ref[100], frame[20], faults=0, next=0;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter reference string: ");
    for(int i=0;i<n;i++) scanf("%d",&ref[i]);

    printf("Enter number of frames: ");
    scanf("%d",&frames);

    for(int i=0;i<frames;i++) frame[i]=-1;

    printf("\nReference\tFrames\n");

    for(int i=0;i<n;i++){
        int hit=0;
        for(int j=0;j<frames;j++)
            if(frame[j]==ref[i]) hit=1;

        if(!hit){
            frame[next]=ref[i];
            next=(next+1)%frames;
            faults++;
        }

        printf("%d\t\t",ref[i]);
        for(int j=0;j<frames;j++) printf("%d ",frame[j]);
        printf("\n");
    }

    printf("Total Page Faults = %d\n",faults);
    return 0;
}
##Experiment 13(b): PAGE REPLACEMENT — LRU
#include <stdio.h>

int findLRU(int time[], int n)
{
    int pos=0;
    for(int i=1;i<n;i++)
        if(time[i]<time[pos]) pos=i;
    return pos;
}

int main(void)
{
    int f,pages[100],frame[20],time[20];
    int counter=0,faults=0;

    printf("Enter number of frames: ");
    scanf("%d",&f);
    printf("Enter number of pages: ");
    int n; scanf("%d",&n);

    printf("Enter reference string: ");
    for(int i=0;i<n;i++) scanf("%d",&pages[i]);

    for(int i=0;i<f;i++){ frame[i]=-1; time[i]=0; }

    for(int i=0;i<n;i++){
        int hit=-1;
        for(int j=0;j<f;j++)
            if(frame[j]==pages[i]) hit=j;

        counter++;

        if(hit!=-1){
            time[hit]=counter;
        }else{
            int pos=-1;
            for(int j=0;j<f;j++)
                if(frame[j]==-1){ pos=j; break; }

            if(pos==-1) pos=findLRU(time,f);

            frame[pos]=pages[i];
            time[pos]=counter;
            faults++;
        }

        for(int j=0;j<f;j++) printf("%d\t",frame[j]);
        printf("\n");
    }

    printf("Total Page Faults = %d\n",faults);
    return 0;
}
##Experiment 13(c): PAGE REPLACEMENT — LFU
#include <stdio.h>

int main(void)
{
    int n,f,pages[100],frame[20],freq[20],age[20];
    int faults=0,timer=0;

    printf("Enter number of pages: ");
    scanf("%d",&n);
    printf("Enter reference string: ");
    for(int i=0;i<n;i++) scanf("%d",&pages[i]);

    printf("Enter number of frames: ");
    scanf("%d",&f);

    for(int i=0;i<f;i++){
        frame[i]=-1;
        freq[i]=0;
        age[i]=0;
    }

    for(int i=0;i<n;i++){
        timer++;
        int pos=-1;

        for(int j=0;j<f;j++)
            if(frame[j]==pages[i]) pos=j;

        if(pos!=-1){
            freq[pos]++;
            age[pos]=timer;
        }else{
            for(int j=0;j<f;j++)
                if(frame[j]==-1){ pos=j; break; }

            if(pos==-1){
                pos=0;
                for(int j=1;j<f;j++)
                    if(freq[j]<freq[pos] ||
                       (freq[j]==freq[pos] && age[j]<age[pos]))
                        pos=j;
            }

            frame[pos]=pages[i];
            freq[pos]=1;
            age[pos]=timer;
            faults++;
        }

        for(int j=0;j<f;j++) printf("%d\t",frame[j]);
        printf("\n");
    }

    printf("Total Page Faults = %d\n",faults);
    return 0;
}




